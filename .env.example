# Backend API key (required, minimum 32 chars). Generate locally; never commit real values.
GORDIAN_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Optional: comma-separated trusted origins for browser clients.
GORDIAN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional dashboard/dev client settings.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000
VITE_WS_PATH=/api/v1/live
